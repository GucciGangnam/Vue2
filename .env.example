# Supabase project: Vue2 PROD (ref: grzsrhsdifohwbmbpebi)
# Copy to .env and fill in. Only the publishable key belongs here --
# never put the service_role key in a client-side env file.
VITE_SUPABASE_URL=https://grzsrhsdifohwbmbpebi.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...

# Largest object Supabase Storage will accept, in bytes. Optional; defaults to
# 50 MiB (52428800), which is the free plan's cap.
#
# This is a PROJECT setting, not a bucket setting: raising a bucket's
# file_size_limit does not raise it. On a paid plan, raise the project's
# "Upload file size limit" first, then set this to match. The app derives the
# per-video plaintext cap from it, allowing for one 16-byte GCM tag per 1 MiB
# chunk, and refuses larger files before spending time encrypting them.
# VITE_MAX_CIPHERTEXT_BYTES=52428800
